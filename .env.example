# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Postgres / pgvector ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sonpur_mela

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Ollama models to pull after `docker compose up` ---
# ollama pull llama3.1:8b        (or qwen2.5:7b / mistral:7b)
# ollama pull nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://ollama:11434

# --- WhatsApp Cloud API (Meta) ---
# From your Meta developer app / WhatsApp Business account.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me

# --- District control room fallback number shown in disclaimers ---
DISTRICT_CONTROL_ROOM_NUMBER=
