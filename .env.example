# Copy to .env (prod) or .env.staging and fill in. Never commit real values.
# Generate secrets with:  openssl rand -hex 32

ENV=prod                              # prod | staging | test
PUBLIC_HOST=bot.example.in            # hostname Meta calls (tunnel route or VPS DNS)

# --- Postgres (both databases: citizen_bot + n8n) ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
PG_HOST_PORT=5432                     # 127.0.0.1 only; use 5433 for a staging stack
N8N_HOST_PORT=5678                    # 127.0.0.1 only; use 5679 for a staging stack

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me          # BACK THIS UP: losing it makes stored credentials unreadable
EXECUTIONS_MODE=regular               # "queue" + compose profile "scale" for more capacity (docs/runbook.md)
N8N_CONCURRENCY_PRODUCTION_LIMIT=10   # regular mode: bound concurrent executions under a spike

# --- WhatsApp Cloud API (Meta developer app) ---
META_APP_SECRET=                      # App settings > Basic > App secret (webhook signature check)
WHATSAPP_VERIFY_TOKEN=change-me       # any random string; same value in Meta's webhook config
WHATSAPP_PHONE_NUMBER_ID=             # WhatsApp > API setup
WHATSAPP_ACCESS_TOKEN=                # permanent System User token (not the 24h test token)
GRAPH_API_VERSION=v23.0               # set to the current version shown in Meta's dashboard
WA_API_BASE=https://graph.facebook.com

# --- LLM (free-text understanding only; never states facts) ---
ANTHROPIC_API_KEY=
LLM_ENABLED=true                      # hard off-switch; also: UPDATE core.settings SET value='false' WHERE key='llm_enabled'
LLM_MODEL=claude-haiku-4-5

# --- Privacy (DPDP): citizen numbers are hashed for analytics and encrypted at rest ---
PHONE_HASH_SECRET=change-me           # never change after go-live (hashes would stop matching)
PGCRYPTO_KEY=change-me                # back up; needed to decrypt stored numbers

# --- Admins: comma-separated WhatsApp numbers with country code (alerts + admin tools) ---
ADMIN_WA_NUMBERS=
ADMIN_ALERT_TEMPLATE=admin_alert      # approved utility template with one body variable

# --- Sonpur Mela data: Google Sheet read every 10 minutes by sync-mela ---
MELA_SHEET_ID=                        # the id in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SA_JSON=                       # service-account key JSON (or its base64); share the sheet with its client_email as Viewer

# --- Office machine: Cloudflare Tunnel token (profile "tunnel") ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Analytics (M3) ---
# Daily report at 08:00 IST: always sent to ADMIN_WA_NUMBERS as the admin_alert template;
# also e-mailed (full text) when SMTP_HOST and REPORT_EMAIL_TO are set.
SMTP_HOST=                            # e.g. smtp.gmail.com (use an app password) or NIC mail relay
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false                     # true for port 465; false = STARTTLS on 587
REPORT_EMAIL_TO=                      # comma-separated
REPORT_EMAIL_FROM=
# Metabase (compose profile "analytics"): scripts/metabase_setup.py builds the dashboard.
METABASE_DB_PASSWORD=change-me        # read-only DB login metabase_ro (sees only the analytics schema)
MB_ADMIN_EMAIL=
MB_ADMIN_PASSWORD=
