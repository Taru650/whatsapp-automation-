# Environment for automated tests (local dev and CI). No real secrets here.
ENV=test
META_APP_SECRET=test-app-secret
WHATSAPP_VERIFY_TOKEN=test-verify-token
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_ACCESS_TOKEN=test-access-token
WA_API_BASE=http://127.0.0.1:8081
GRAPH_API_VERSION=v23.0
ANTHROPIC_BASE_URL=http://127.0.0.1:8082
ANTHROPIC_API_KEY=test-key
LLM_ENABLED=true
LLM_MODEL=claude-haiku-4-5
PHONE_HASH_SECRET=test-phone-hash-secret
PGCRYPTO_KEY=test-pgcrypto-key
ADMIN_WA_NUMBERS=919000000099
ADMIN_ALERT_TEMPLATE=admin_alert
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
GENERIC_TIMEZONE=Asia/Kolkata
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_SECURE_COOKIE=false
MELA_SHEET_ID=test-mela-sheet
SHEETS_API_BASE=http://127.0.0.1:8083
GOOGLE_TOKEN_URL=http://127.0.0.1:8083/token
N8N_CONCURRENCY_PRODUCTION_LIMIT=8
SMTP_HOST=127.0.0.1
SMTP_PORT=8084
SMTP_DISABLE_STARTTLS=true
REPORT_EMAIL_TO=dm-office@example.test
REPORT_EMAIL_FROM=citizen-bot@example.test
