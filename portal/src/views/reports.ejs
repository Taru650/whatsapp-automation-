<%- include('partials/head') %>
<h1 class="h4 mb-3">Reports</h1>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<form class="row g-2 mb-3" method="get" action="<%= base %>/reports">
  <div class="col-6 col-md-2">
    <label class="form-label small" for="from">Filed from</label>
    <input class="form-control" type="date" id="from" name="from" value="<%= f.from %>">
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label small" for="to">to</label>
    <input class="form-control" type="date" id="to" name="to" value="<%= f.to %>">
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label small" for="status">Status</label>
    <select class="form-select" id="status" name="status">
      <option value="">Any</option>
      <% for (const s of ['open', 'assigned', 'in_progress', 'closed']) { %>
      <option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= STATUS_LABEL[s] %></option>
      <% } %>
    </select>
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label small" for="category">Category</label>
    <select class="form-select" id="category" name="category">
      <option value="">Any</option>
      <% for (const c of categories) { %>
      <option value="<%= c.category_key %>" <%= f.category === c.category_key ? 'selected' : '' %>><%= c.label_en %></option>
      <% } %>
    </select>
  </div>
  <% if (user.role === 'district_admin') { %>
  <div class="col-6 col-md-2">
    <label class="form-label small" for="department">Department</label>
    <select class="form-select" id="department" name="department">
      <option value="">Any</option>
      <% for (const d of departments) { %>
      <option value="<%= d.department_id %>" <%= f.department === d.department_id ? 'selected' : '' %>><%= d.name_en %></option>
      <% } %>
    </select>
  </div>
  <% } %>
  <div class="col-6 col-md-auto d-flex align-items-end">
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" name="overdue" value="1" id="overdue" <%= f.overdue ? 'checked' : '' %>>
      <label class="form-check-label" for="overdue">Overdue only</label>
    </div>
  </div>
  <div class="col-12 col-md-auto d-flex align-items-end"><button class="btn btn-outline-primary w-100">Show</button></div>
</form>

<% if (!error) { %>
<div class="d-flex flex-wrap gap-2 mb-3">
  <a class="btn btn-success" href="<%= base %>/reports/complaints.xlsx<%= qs ? '?' + qs : '' %>">Download Excel</a>
  <a class="btn btn-danger" href="<%= base %>/reports/complaints.pdf<%= qs ? '?' + qs : '' %>">Download PDF</a>
</div>
<p class="small text-muted">Excel has every detail, including the citizen's description. The PDF is a printable summary. Every download is recorded.</p>
<% if (!summary.length) { %>
<p class="text-muted">No complaints match.</p>
<% } else { %>
<div class="table-responsive">
<table class="table table-sm">
  <thead><tr><th>Department</th><th class="text-end">Open</th><th class="text-end">Assigned</th><th class="text-end">In progress</th><th class="text-end">Closed</th><th class="text-end text-danger">Overdue</th><th class="text-end">Total</th></tr></thead>
  <tbody>
  <% for (const x of summary) { %>
    <tr><td><%= x.department %></td><td class="text-end"><%= x.open %></td><td class="text-end"><%= x.assigned %></td><td class="text-end"><%= x.in_progress %></td><td class="text-end"><%= x.closed %></td><td class="text-end text-danger"><%= x.overdue || '' %></td><td class="text-end fw-semibold"><%= x.total %></td></tr>
  <% } %>
  </tbody>
</table>
</div>
<% } %>
<% } %>
<%- include('partials/foot') %>
