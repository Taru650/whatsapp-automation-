<%- include('partials/head') %>
<h1 class="h4 mb-3">Dashboard <span class="text-muted small">(<%= user.role === 'district_admin' ? 'all departments' : user.role === 'dept_head' ? user.department_en : 'assigned to you' %>)</span></h1>
<div class="row g-2 mb-3">
  <% for (const s of ['open', 'assigned', 'in_progress', 'resolved', 'closed']) { %>
  <div class="col-6 col-md">
    <a class="card text-decoration-none h-100" href="<%= base %>/complaints?status=<%= s %>">
      <div class="card-body py-2">
        <div class="small text-muted"><%= STATUS_LABEL[s] %></div>
        <div class="fs-3 fw-semibold"><%= counts[s] %></div>
      </div>
    </a>
  </div>
  <% } %>
  <div class="col-6 col-md">
    <a class="card text-decoration-none h-100 border-danger" href="<%= base %>/complaints?overdue=1">
      <div class="card-body py-2">
        <div class="small text-danger">Overdue</div>
        <div class="fs-3 fw-semibold text-danger"><%= overdue %></div>
      </div>
    </a>
  </div>
</div>
<% if (total) { %>
<div class="row g-3 mb-3">
  <div class="col-md-5"><div class="card"><div class="card-body"><h2 class="h6">By status</h2><div class="chart-box"><canvas id="chart-status"></canvas></div></div></div></div>
  <div class="col-md-7"><div class="card"><div class="card-body"><h2 class="h6">Pending, by category</h2><div class="chart-box"><canvas id="chart-category"></canvas></div></div></div></div>
</div>
<% } %>
<h2 class="h6">Latest pending</h2>
<% if (!recent.length) { %>
<p class="text-muted">Nothing pending.</p>
<% } else { %>
<div class="list-group mb-3">
  <% for (const c of recent) { %>
  <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="<%= base %>/complaints/<%= c.complaint_id %>">
    <span><strong><%= c.complaint_id %></strong> · <%= c.category_en %> <span class="text-muted small">· <%= fmtTime(c.created_at) %></span></span>
    <span class="badge <%= STATUS_BADGE[c.status] %>"><%= STATUS_LABEL[c.status] %></span>
  </a>
  <% } %>
</div>
<% } %>
<script type="application/json" id="chart-data"><%- JSON.stringify(chart).replace(/</g, '\\u003c') %></script>
<script src="<%= base %>/static/chart/chart.umd.min.js"></script>
<script src="<%= base %>/static/dashboard.js"></script>
<%- include('partials/foot') %>
