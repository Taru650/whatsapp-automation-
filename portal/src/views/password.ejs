<%- include('partials/head') %>
<div class="row justify-content-center">
  <div class="col-sm-8 col-md-6 col-lg-5">
    <h1 class="h4 mb-3">Change password</h1>
    <% if (user.must_change_password) { %>
    <div class="alert alert-warning">Choose your own password before you continue.</div>
    <% } %>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <form method="post" action="<%= base %>/password">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="mb-3">
        <label class="form-label" for="current">Current (or temporary) password</label>
        <input class="form-control" id="current" name="current" type="password" autocomplete="current-password" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">New password <span class="text-muted small">(at least 10 characters)</span></label>
        <input class="form-control" id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="confirm">New password again</label>
        <input class="form-control" id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="10" required>
      </div>
      <button class="btn btn-primary">Save</button>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
