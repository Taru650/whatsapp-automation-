<%- include('partials/head') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Staff accounts</h1>
  <a class="btn btn-primary btn-sm" href="<%= base %>/users/new">New account</a>
</div>
<% if (!users.length) { %>
<p class="text-muted">No accounts yet.</p>
<% } else { %>
<div class="table-responsive">
<table class="table table-sm align-middle">
  <thead><tr><th>Name</th><th>Username</th><th>Role</th><th class="d-none d-md-table-cell">Department</th><th class="d-none d-md-table-cell">Last sign-in</th><th></th></tr></thead>
  <tbody>
  <% for (const u of users) { %>
    <tr class="<%= u.enabled ? '' : 'text-muted' %>">
      <td><%= u.full_name %><% if (!u.enabled) { %> <span class="badge text-bg-secondary">Disabled</span><% } %></td>
      <td><code><%= u.username %></code></td>
      <td><%= ROLE_LABEL[u.role] %></td>
      <td class="d-none d-md-table-cell"><%= u.department_en || '—' %></td>
      <td class="d-none d-md-table-cell small"><%= u.last_login_at ? fmtTime(u.last_login_at) : 'never' %></td>
      <td class="text-end text-nowrap">
        <% if (u.manageable) { %>
        <form class="d-inline" method="post" action="<%= base %>/users/<%= u.user_id %>/reset-password" data-confirm="Reset the password for <%= u.full_name %>?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm btn-outline-secondary">Reset password</button>
        </form>
        <form class="d-inline" method="post" action="<%= base %>/users/<%= u.user_id %>/<%= u.enabled ? 'disable' : 'enable' %>"<% if (u.enabled) { %> data-confirm="Disable <%= u.full_name %>? They are signed out immediately."<% } %>>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm <%= u.enabled ? 'btn-outline-danger' : 'btn-outline-success' %>"><%= u.enabled ? 'Disable' : 'Enable' %></button>
        </form>
        <% } %>
      </td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<% } %>
<%- include('partials/foot') %>
