<%- include('partials/head') %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <h1 class="h4 mb-3">Temporary password for <%= target.full_name %></h1>
    <div class="alert alert-warning">
      This is shown <strong>only once</strong>. Give it to <%= target.full_name %> in person or by phone — not on WhatsApp groups.
      They must choose their own password when they sign in.
    </div>
    <p>Username: <code class="fs-5"><%= target.username %></code></p>
    <p>Temporary password: <code class="fs-4 user-select-all"><%= temp %></code></p>
    <a class="btn btn-primary" href="<%= base %>/users">Done</a>
  </div>
</div>
<%- include('partials/foot') %>
