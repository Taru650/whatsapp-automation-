{
  "name": "Sonpur Mela WhatsApp Bot",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "note-verify",
      "name": "Note - Verify Handshake",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, -220],
      "parameters": {
        "width": 500,
        "height": 200,
        "content": "## WhatsApp webhook verification\nMeta sends a one-time GET request when you register this webhook URL in the Meta App dashboard. It must echo back `hub.challenge` if `hub.verify_token` matches WHATSAPP_VERIFY_TOKEN."
      }
    },
    {
      "id": "n1",
      "name": "Verify Webhook (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "GET",
        "path": "sonpur-mela-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Check Verify Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query['hub.mode'] }}",
              "rightValue": "subscribe",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.WHATSAPP_VERIFY_TOKEN }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Respond Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, -60],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}"
      }
    },
    {
      "id": "n4",
      "name": "Respond Verify Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 60],
      "parameters": {
        "respondWith": "text",
        "responseBody": "Verification failed",
        "options": { "responseCode": 403 }
      }
    },
    {
      "id": "note-incoming",
      "name": "Note - Incoming Messages",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, 260],
      "parameters": {
        "width": 500,
        "height": 200,
        "content": "## Incoming messages\nEvery inbound message, delivery receipt, and status update from WhatsApp Cloud API POSTs here. We must return 200 quickly, even for message types we don't handle yet."
      }
    },
    {
      "id": "n5",
      "name": "Incoming Message (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 320],
      "parameters": {
        "httpMethod": "POST",
        "path": "sonpur-mela-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "n6",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 320],
      "parameters": {
        "jsCode": "const body = $json.body;\nconst entry = body?.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\n\nif (!message) {\n  return [{ json: { isMessage: false } }];\n}\n\nreturn [{\n  json: {\n    isMessage: true,\n    messageType: message.type,\n    messageText: message.type === 'text' ? message.text.body : '',\n    from: message.from,\n    waMessageId: message.id\n  }\n}];"
      }
    },
    {
      "id": "n7",
      "name": "Is Text Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 320],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.isMessage }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.messageType }}",
              "rightValue": "text",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n8",
      "name": "Ack Non-Text",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 420],
      "parameters": { "respondWith": "text", "responseBody": "OK" }
    },
    {
      "id": "note-routing",
      "name": "Note - Intent Routing",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [660, -140],
      "parameters": {
        "width": 480,
        "height": 220,
        "content": "## Cheap keyword routing before the LLM\nSimple contact lookups (\"police number\", \"medical camp\") get a direct, deterministic DB answer without touching the LLM at all — faster, and can't hallucinate a phone number. Only genuinely open-ended questions fall through to retrieval + Ollama."
      }
    },
    {
      "id": "n9",
      "name": "Classify Category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 260],
      "parameters": {
        "jsCode": "const text = ($json.messageText || '').toLowerCase();\nconst rules = [\n  { category: 'police', keywords: ['police', 'thana', 'chowki'] },\n  { category: 'medical', keywords: ['medical', 'hospital', 'doctor', 'ambulance'] },\n  { category: 'veterinary', keywords: ['veterinary', 'animal camp', 'cattle', ' vet'] },\n  { category: 'control_room', keywords: ['control room', 'helpline'] },\n  { category: 'law_order', keywords: ['magistrate', 'law and order', 'law & order'] }\n];\n\nlet category = null;\nfor (const rule of rules) {\n  if (rule.keywords.some((k) => text.includes(k))) {\n    category = rule.category;\n    break;\n  }\n}\n\nreturn [{ json: { ...$json, category } }];"
      }
    },
    {
      "id": "n10",
      "name": "Has Direct Category?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 260],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.category }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n11",
      "name": "Direct Lookup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, 160],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ \"SELECT name, phone, location, hours FROM facilities WHERE category = '\" + $json.category + \"' ORDER BY name;\" }}",
        "options": {}
      }
    },
    {
      "id": "n12",
      "name": "Format Direct Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 160],
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst controlRoom = $env.DISTRICT_CONTROL_ROOM_NUMBER;\nlet replyText;\n\nif (!rows.length) {\n  replyText = `Sorry, I don't have that listed yet. Please contact the District Control Room: ${controlRoom}`;\n} else {\n  replyText = rows\n    .map((r) => `${r.name}\\nPhone: ${r.phone}\\nLocation: ${r.location}\\nHours: ${r.hours}`)\n    .join('\\n\\n');\n}\n\nreturn [{ json: { to: $('Extract Message').first().json.from, replyText } }];"
      }
    },
    {
      "id": "note-rag",
      "name": "Note - RAG Path",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1100, 500],
      "parameters": {
        "width": 620,
        "height": 260,
        "content": "## Retrieval-augmented path\nEmbed the question with the local embedding model, pull the closest facility + history records from Postgres/pgvector, and only let the LLM phrase an answer FROM those records. It never has to recall a phone number from memory, so it can't misremember one. If nothing relevant is retrieved, we skip the LLM entirely and hand back the control room fallback number."
      }
    },
    {
      "id": "n13",
      "name": "Embed Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 340],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_BASE_URL + '/api/embeddings' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: $env.OLLAMA_EMBED_MODEL, prompt: $('Classify Category').first().json.messageText } }}",
        "options": {}
      }
    },
    {
      "id": "n14",
      "name": "Prepare Vector Literal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 340],
      "parameters": {
        "jsCode": "const vec = $json.embedding;\nconst literal = '[' + vec.join(',') + ']';\nreturn [{ json: { embeddingLiteral: literal } }];"
      }
    },
    {
      "id": "n15",
      "name": "Vector Search",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1540, 340],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ \"SELECT category, name AS title, phone, location, hours, notes AS content, (embedding <=> '\" + $json.embeddingLiteral + \"'::vector) AS distance, 'facility' AS kind FROM facilities UNION ALL SELECT NULL AS category, source AS title, NULL AS phone, NULL AS location, NULL AS hours, content, (embedding <=> '\" + $json.embeddingLiteral + \"'::vector) AS distance, 'history' AS kind FROM history_chunks ORDER BY distance ASC LIMIT 5;\" }}",
        "options": {}
      }
    },
    {
      "id": "n16",
      "name": "Build RAG Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 340],
      "parameters": {
        "jsCode": "const results = $input.all().map((i) => i.json);\nconst question = $('Classify Category').first().json.messageText;\nconst controlRoom = $env.DISTRICT_CONTROL_ROOM_NUMBER;\n// Cosine distance threshold - tune this after testing with real questions.\nconst CONFIDENCE_THRESHOLD = 0.35;\nconst bestDistance = results.length ? Math.min(...results.map((r) => r.distance)) : 1;\n\nif (!results.length || bestDistance > CONFIDENCE_THRESHOLD) {\n  return [{\n    json: {\n      lowConfidence: true,\n      to: $('Extract Message').first().json.from,\n      replyText: `I'm not certain about that. Please contact the District Control Room: ${controlRoom}`\n    }\n  }];\n}\n\nconst context = results\n  .map((r) => (r.kind === 'facility'\n    ? `[${r.category}] ${r.title} — Phone: ${r.phone}, Location: ${r.location}, Hours: ${r.hours}`\n    : `${r.title}: ${r.content}`))\n  .join('\\n');\n\nconst prompt = `You are a helpful assistant for Sonpur Mela visitors. Answer ONLY using the context below. If the answer isn't in the context, say you don't know and give the District Control Room number ${controlRoom}. Keep the answer short.\\n\\nContext:\\n${context}\\n\\nQuestion: ${question}\\n\\nAnswer:`;\n\nreturn [{ json: { lowConfidence: false, prompt, to: $('Extract Message').first().json.from } }];"
      }
    },
    {
      "id": "n17",
      "name": "Low Confidence?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 340],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.lowConfidence }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n18",
      "name": "Pass Fallback Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2200, 420],
      "parameters": {
        "jsCode": "return [{ json: { to: $json.to, replyText: $json.replyText } }];"
      }
    },
    {
      "id": "n19",
      "name": "Ollama Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 260],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_BASE_URL + '/api/generate' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: $env.OLLAMA_CHAT_MODEL, prompt: $json.prompt, stream: false } }}",
        "options": {}
      }
    },
    {
      "id": "n20",
      "name": "Format RAG Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2420, 260],
      "parameters": {
        "jsCode": "return [{ json: { to: $('Build RAG Prompt').first().json.to, replyText: $json.response } }];"
      }
    },
    {
      "id": "note-send",
      "name": "Note - Sending the reply",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [2640, -140],
      "parameters": {
        "width": 460,
        "height": 200,
        "content": "## Sending back to WhatsApp\nCalls the Meta Graph API directly (no n8n-specific WhatsApp credential needed) using WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID from the n8n environment. All three answer branches (direct lookup, RAG answer, low-confidence fallback) converge here."
      }
    },
    {
      "id": "n21",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 260],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v19.0/' + $env.WHATSAPP_PHONE_NUMBER_ID + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.WHATSAPP_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', to: $json.to, type: 'text', text: { body: $json.replyText } } }}",
        "options": {}
      }
    },
    {
      "id": "n22",
      "name": "Ack Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2860, 260],
      "parameters": { "respondWith": "text", "responseBody": "OK" }
    }
  ],
